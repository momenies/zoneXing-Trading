# ── مفاتيح المنصات (اختيارية) ───────────────────────────────────────────
#
# شموع الأسعار (candles) على OKX و Binance نقاط وصول عامة ولا تحتاج مفتاح.
# فائدة المفتاح الوحيدة هنا: رفع حد الطلبات عند سحب عشرات الآلاف من الشموع.
#
# انسخ هذا الملف إلى .env وعبّئ القيم:   cp .env.example .env
# ملف .env متجاهَل في .gitignore — لا يُرفع للمستودع أبداً.
#
# مهم: لا تحتاج صلاحيات تداول. أنشئ المفتاح بصلاحية "قراءة فقط" (Read only)
# وبدون صلاحية سحب. هذا المشروع يقرأ أسعاراً فقط ولا ينفّذ أي أمر.

# Binance — يُرسل كترويسة X-MBX-APIKEY
BINANCE_API_KEY=
BINANCE_API_SECRET=

# OKX — يحتاج الثلاثة معاً
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# المنصة المفضلة للسحب: okx | binance | auto
EXCHANGE_VENUE=auto
