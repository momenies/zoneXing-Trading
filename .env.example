# ─────────────────────────────────────────────────────────────────────────
# zoneXing Trading — live runner configuration
# Copy to `.env` on the server:  cp .env.example .env && nano .env
# NEVER commit the real .env (it is git-ignored).
# ─────────────────────────────────────────────────────────────────────────

# paper = real prices, simulated fills (START HERE).  live = real orders.
MODE=paper

EXCHANGE=okx                 # any ccxt id: okx, binance, bybit, kucoinfutures…
MARKET_TYPE=swap             # swap = USDT perps (shorts allowed) | spot = long only
TESTNET=false                # true = exchange demo/sandbox account

# Required only when MODE=live
API_KEY=
API_SECRET=
API_PASSWORD=                # OKX / KuCoin passphrase; leave blank elsewhere
I_UNDERSTAND_LIVE_RISK=      # must be exactly: yes   (safety interlock)

# ── universe ────────────────────────────────────────────────────────────
GATE_SYMBOL=BTC-USDT         # master gate — NEVER traded (refused if listed below)
SYMBOLS=ETH-USDT,BNB-USDT,SOL-USDT,XRP-USDT,DOGE-USDT
TIMEFRAME=5m
HISTORY_BARS=300

# ── strategy (keep in sync with whatever you backtested) ────────────────
GATE_BARS=48
GATE_TH=0.002
P_BARS=8
FAST_EMA=8
SLOW_EMA=21
ATR_PERIOD=14
ATR_SL_MULT=1.5
SL_PCT=0.02
TP_PCT=0.04
COOLDOWN=3
MIN_HOLD=3
INVEST_FRAC=0.2              # equity fraction per position
PIVOT_MODE=donchian          # donchian (causal, recommended) | fractal_confirmed

# ── execution / risk ────────────────────────────────────────────────────
LEVERAGE=1
PAPER_EQUITY=1200
TAKER_RATE=0.0005
SLIPPAGE=0.0005
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=5         # halt NEW entries for the rest of the UTC day
MAX_CONSECUTIVE_LOSSES=6     # halt NEW entries until restart
PROTECTIVE_ORDERS=true       # exchange-side reduce-only SL/TP (swap only)
CLOSE_ON_EXIT=false          # flatten everything on SIGTERM

# ── ops ─────────────────────────────────────────────────────────────────
POLL_BUFFER_SEC=8
LOG_LEVEL=INFO
STATE_DIR=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
